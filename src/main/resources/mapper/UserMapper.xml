<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.road_friends.everycar.user.mapper.UserMapper">
    <select id="findAllUsers" resultType="com.road_friends.everycar.user.dto.UserDTO">
        SELECT user_id, user_password, user_name, user_role
        FROM user
        WHERE user_id = #{userId}
    </select>
</mapper>
